# =============================================================================
# Voice Agent Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# --- Provider Selection ---
# Options: "groq" (free, open-source!), "github" (free), "openai", or "elevenlabs"
VOICE_PROVIDER=groq

# --- Groq Configuration (FREE - recommended, open-source models) ---
# Get your free API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TTS_VOICE=en-US-AndrewMultilingualNeural
# Model options: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b,
#   mixtral-8x7b-32768, gemma2-9b-it, llama-3.1-8b-instant

# --- GitHub Models Configuration (FREE) ---
# Get your token: GitHub → Settings → Developer Settings → Personal Access Tokens
# Create a fine-grained token with "models:read" permission
GITHUB_TOKEN=ghp_your-github-token
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4o
GITHUB_TTS_VOICE=en-US-AndrewMultilingualNeural
# TTS Voice Options (Edge-TTS, free):
#   en-US-AndrewMultilingualNeural, en-US-AvaMultilingualNeural,
#   en-US-BrianMultilingualNeural, en-US-EmmaMultilingualNeural,
#   en-GB-SoniaNeural, en-ZA-LeahNeural

# --- OpenAI Configuration (requires paid API key) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# --- ElevenLabs Configuration (requires API key) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2

# --- Application Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=info

# --- Agent Configuration ---
AGENT_NAME=Atlas
AGENT_PERSONA=You are Atlas, a helpful and knowledgeable AI voice assistant. You speak naturally and conversationally. You are concise but thorough.
MAX_CONVERSATION_TURNS=50
TURN_DETECTION_THRESHOLD=0.5
